diff --git a/products/signals/backend/emission/appsignal_exception_incidents.py b/products/signals/backend/emission/appsignal_exception_incidents.py
new file mode 100644
index 000000000000..ce0177041b36
--- /dev/null
+++ b/products/signals/backend/emission/appsignal_exception_incidents.py
@@ -0,0 +1,49 @@
+"""Signal emitter for appsignal `exception_incidents` (record kind: issue).
+
+Each row is an incident that AppSignal already groups from many error samples.
+`created_at` is an ISO string and never changes, so the time cursor emits each incident once.
+`state` is OPEN, WIP or CLOSED.
+"""
+
+from products.signals.backend.emission._common import make_flat_emitter
+from products.signals.backend.emission._prompts import ERROR_ACTIONABILITY_PROMPT, ERROR_SUMMARIZATION_PROMPT
+from products.signals.backend.emission.fetchers.data_warehouse import data_warehouse_record_fetcher
+from products.signals.backend.emission.registry import SignalSourceTableConfig
+
+# The headline joins the exception name and message, and uses whichever one is set when the other is empty.
+APPSIGNAL_FIELDS = (
+    "id",
+    "if(ifNull(exception_message, '') = '', ifNull(exception_name, ''), "
+    "if(ifNull(exception_name, '') = '', exception_message, "
+    "concat(exception_name, ': ', exception_message))) AS headline",
+    "first_backtrace_line AS backtrace_line",
+    "state",
+    "severity",
+    "namespace",
+    "count AS occurrence_count",
+    "created_at",
+    "last_occurred_at",
+)
+
+APPSIGNAL_CONFIG = SignalSourceTableConfig(
+    source_product="appsignal",
+    source_type="issue",
+    emitter=make_flat_emitter(
+        source_product="appsignal",
+        source_type="issue",
+        id_field="id",
+        title_field="headline",
+        body_field="backtrace_line",
+        extra_fields=("state", "severity", "namespace", "occurrence_count", "created_at", "last_occurred_at"),
+    ),
+    record_fetcher=data_warehouse_record_fetcher,
+    partition_field="toString(created_at)",
+    partition_field_is_datetime_string=True,
+    fields=APPSIGNAL_FIELDS,
+    where_clause="state != 'CLOSED'",
+    max_records=200,
+    first_sync_lookback_days=1,
+    actionability_prompt=ERROR_ACTIONABILITY_PROMPT,
+    summarization_prompt=ERROR_SUMMARIZATION_PROMPT,
+    description_summarization_threshold_chars=2000,
+)
diff --git a/products/signals/backend/emission/azure_application_insights_exceptions.py b/products/signals/backend/emission/azure_application_insights_exceptions.py
new file mode 100644
index 000000000000..6af946e50c36
--- /dev/null
+++ b/products/signals/backend/emission/azure_application_insights_exceptions.py
@@ -0,0 +1,109 @@
+"""Signal emitter for azure_application_insights `exceptions` (record kind: issue).
+
+The table holds one row per exception occurrence.
+The fetcher groups the rows of a trailing window by `problem_id`, and the emitter produces one signal per problem, at most once per ISO week.
+The emission ledger and the weekly fingerprint keep re-reading the same rows safe.
+"""
+
+import hashlib
+from typing import Any
+
+from structlog import get_logger
+
+from products.signals.backend.emission._common import build_extra
+from products.signals.backend.emission._prompts import ERROR_ACTIONABILITY_PROMPT, ERROR_SUMMARIZATION_PROMPT
+from products.signals.backend.emission.datadog_common import clean_text
+from products.signals.backend.emission.fetchers.grouped_warehouse import grouped_warehouse_record_fetcher, week_period
+from products.signals.backend.emission.registry import SignalEmitterOutput, SignalSourceTableConfig
+
+logger = get_logger(__name__)
+
+AZURE_EXCEPTION_FIELDS = (
+    "problem_id",
+    "exception_type",
+    "sample_message",
+    "role_name",
+    "occurrences",
+    "first_seen",
+    "last_seen",
+)
+
+_EXTRA_FIELDS = tuple(f for f in AZURE_EXCEPTION_FIELDS if f not in ("sample_message",))
+_MAX_MESSAGE_CHARS = 300
+
+_SELECT_SQL = """
+    problem_id,
+    any(type) AS exception_type,
+    any(outer_message) AS sample_message,
+    any(cloud_role_name) AS role_name,
+    count() AS occurrences,
+    min(timestamp) AS first_seen,
+    max(timestamp) AS last_seen
+"""
+
+
+def exception_source_id(record: dict[str, Any]) -> str:
+    # The week lets a fixed problem that returns, or one that stays noisy, emit again.
+    fingerprint = "|".join((clean_text(record.get("problem_id")), week_period(record.get("last_seen"))))
+    return "exception:" + hashlib.sha256(fingerprint.encode("utf-8")).hexdigest()
+
+
+azure_exception_record_fetcher = grouped_warehouse_record_fetcher(
+    select_sql=_SELECT_SQL,
+    group_by_sql="problem_id",
+    order_by_sql="occurrences DESC",
+    source_id_for=exception_source_id,
+)
+
+
+def azure_exception_emitter(team_id: int, record: dict[str, Any]) -> SignalEmitterOutput | None:
+    problem_id = clean_text(record.get("problem_id"))
+    exception_type = clean_text(record.get("exception_type"))
+    message = clean_text(record.get("sample_message"))[:_MAX_MESSAGE_CHARS]
+    if not problem_id or not (exception_type or message):
+        logger.info(
+            "Ignoring azure_application_insights exception group without a type or message",
+            team_id=team_id,
+            signals_type="data-import-signals",
+        )
+        return None
+    role_name = clean_text(record.get("role_name"))
+    occurrences = clean_text(record.get("occurrences"))
+    first_seen = clean_text(record.get("first_seen"))
+    last_seen = clean_text(record.get("last_seen"))
+    summary = f"Exceptions in {role_name}" if role_name else "Exceptions"
+    if occurrences:
+        summary += f": {occurrences} occurrences"
+    if first_seen and last_seen:
+        summary += f" between {first_seen} and {last_seen}"
+    lines = [summary]
+    if exception_type:
+        lines.append(exception_type)
+    if message:
+        lines.append(message)
+    return SignalEmitterOutput(
+        source_product="azure_application_insights",
+        source_type="issue",
+        source_id=exception_source_id(record),
+        description="\n".join(lines),
+        # Below the report threshold of 1.0, so one noisy problem alone cannot open a report.
+        weight=0.5,
+        extra=build_extra(record, _EXTRA_FIELDS, ()),
+    )
+
+
+AZURE_EXCEPTIONS_CONFIG = SignalSourceTableConfig(
+    source_product="azure_application_insights",
+    source_type="issue",
+    emitter=azure_exception_emitter,
+    record_fetcher=azure_exception_record_fetcher,
+    record_processed_outputs=True,
+    partition_field="toString(timestamp)",
+    partition_field_is_datetime_string=True,
+    fields=AZURE_EXCEPTION_FIELDS,
+    where_clause="problem_id != ''",
+    max_records=100,
+    actionability_prompt=ERROR_ACTIONABILITY_PROMPT,
+    summarization_prompt=ERROR_SUMMARIZATION_PROMPT,
+    description_summarization_threshold_chars=2000,
+)
diff --git a/products/signals/backend/emission/cursor_bugbot_reviews.py b/products/signals/backend/emission/cursor_bugbot_reviews.py
new file mode 100644
index 000000000000..d3d77d9769fd
--- /dev/null
+++ b/products/signals/backend/emission/cursor_bugbot_reviews.py
@@ -0,0 +1,122 @@
+"""Signal emitter for cursor `bugbot_reviews` (record kind: issue).
+
+One row is one completed Bugbot review of a pull request.
+Dry runs post nothing, so the query and the emitter skip them, and so they skip reviews with no findings.
+A posted review lists only the severity and resolution status of each finding.
+A finding has a title and a description only when the API returns them, so the text is optional.
+"""
+
+from typing import Any
+
+from structlog import get_logger
+
+from products.signals.backend.emission._common import build_extra, parse_json_list
+from products.signals.backend.emission._prompts import ISSUE_ACTIONABILITY_PROMPT, ISSUE_SUMMARIZATION_PROMPT
+from products.signals.backend.emission.datadog_common import clean_text
+from products.signals.backend.emission.fetchers.data_warehouse import data_warehouse_record_fetcher
+from products.signals.backend.emission.registry import SignalEmitterOutput, SignalSourceTableConfig
+
+logger = get_logger(__name__)
+
+CURSOR_BUGBOT_FIELDS = (
+    "request_id",
+    "timestamp",
+    "repo",
+    "pr_number",
+    "commit_sha",
+    "bugs_found",
+    "dry_run",
+    "publication_status",
+    "bugs",
+)
+
+_EXTRA_FIELDS = ("repo", "pr_number", "commit_sha", "bugs_found", "publication_status", "timestamp")
+_SEVERITY_ORDER = ("critical", "high", "medium", "low")
+_MAX_LISTED_BUGS = 10
+_MAX_BUG_DESCRIPTION_CHARS = 200
+_TRUE_VALUES = ("true", "1")
+
+
+def _bug_lines(bugs: list[Any]) -> list[str]:
+    lines: list[str] = []
+    for bug in bugs:
+        if not isinstance(bug, dict):
+            continue
+        title = clean_text(bug.get("title"))
+        if not title:
+            continue
+        severity = clean_text(bug.get("severity"))
+        line = f"- [{severity}] {title}" if severity else f"- {title}"
+        if description := clean_text(bug.get("description")):
+            line += f": {description[:_MAX_BUG_DESCRIPTION_CHARS]}"
+        lines.append(line)
+        if len(lines) >= _MAX_LISTED_BUGS:
+            break
+    return lines
+
+
+def cursor_bugbot_emitter(team_id: int, record: dict[str, Any]) -> SignalEmitterOutput | None:
+    request_id = clean_text(record.get("request_id"))
+    if not request_id:
+        return None
+    if clean_text(record.get("dry_run")).lower() in _TRUE_VALUES:
+        return None
+    try:
+        bugs_found = int(clean_text(record.get("bugs_found")) or 0)
+    except ValueError:
+        bugs_found = 0
+    if bugs_found <= 0:
+        logger.info(
+            "Ignoring cursor bugbot review without findings",
+            team_id=team_id,
+            signals_type="data-import-signals",
+        )
+        return None
+    bugs = parse_json_list(record.get("bugs"))
+    statuses = [clean_text(bug.get("resolution_status")).lower() for bug in bugs if isinstance(bug, dict)]
+    if statuses and all(status == "resolved" for status in statuses):
+        return None
+    repo = clean_text(record.get("repo"))
+    pr_number = clean_text(record.get("pr_number"))
+    target = " ".join(part for part in (repo, f"PR #{pr_number}" if pr_number else "") if part)
+    noun = "issue" if bugs_found == 1 else "issues"
+    lines = [
+        f"Cursor Bugbot found {bugs_found} {noun} in {target}" if target else f"Cursor Bugbot found {bugs_found} {noun}"
+    ]
+    severities = [clean_text(bug.get("severity")).lower() for bug in bugs if isinstance(bug, dict)]
+    # Known levels come first in a fixed order, then any other level the API returns.
+    levels = [*_SEVERITY_ORDER, *sorted({level for level in severities if level and level not in _SEVERITY_ORDER})]
+    breakdown = ", ".join(f"{severities.count(level)} {level}" for level in levels if severities.count(level) > 0)
+    if breakdown:
+        lines.append(f"Severity: {breakdown}")
+    unresolved = statuses.count("unresolved")
+    if unresolved:
+        lines.append(f"Unresolved: {unresolved}")
+    if commit_sha := clean_text(record.get("commit_sha")):
+        lines.append(f"Commit: {commit_sha}")
+    lines.extend(_bug_lines(bugs))
+    return SignalEmitterOutput(
+        source_product="cursor",
+        source_type="issue",
+        source_id=request_id,
+        description="\n".join(lines),
+        weight=1.0,
+        extra=build_extra(record, _EXTRA_FIELDS, ()),
+    )
+
+
+CURSOR_CONFIG = SignalSourceTableConfig(
+    source_product="cursor",
+    source_type="issue",
+    emitter=cursor_bugbot_emitter,
+    record_fetcher=data_warehouse_record_fetcher,
+    partition_field="timestamp",
+    partition_field_is_datetime_string=True,
+    fields=CURSOR_BUGBOT_FIELDS,
+    where_clause="bugs_found > 0 AND toString(dry_run) NOT IN ('true', '1')",
+    max_records=200,
+    first_sync_lookback_days=1,
+    actionability_prompt=ISSUE_ACTIONABILITY_PROMPT,
+    summarization_prompt=ISSUE_SUMMARIZATION_PROMPT,
+    description_summarization_threshold_chars=2000,
+)
diff --git a/products/signals/backend/emission/google_play_console_error_issues.py b/products/signals/backend/emission/google_play_console_error_issues.py
new file mode 100644
index 000000000000..73229f93a7c3
--- /dev/null
+++ b/products/signals/backend/emission/google_play_console_error_issues.py
@@ -0,0 +1,109 @@
+"""Signal emitter for google_play_console `error_issues` (record kind: issue).
+
+The table is a full refresh with one row per clustered crash or ANR issue, and it has no creation time.
+The fetcher reads the issues with a recent report and the emission ledger keeps each issue name to one signal.
+Aliases differ from the column names, because a grouped query cannot reuse a column name for an aggregate.
+"""
+
+from typing import Any
+
+from structlog import get_logger
+
+from products.signals.backend.emission._common import build_extra
+from products.signals.backend.emission._prompts import ERROR_ACTIONABILITY_PROMPT, ERROR_SUMMARIZATION_PROMPT
+from products.signals.backend.emission.datadog_common import clean_text
+from products.signals.backend.emission.fetchers.grouped_warehouse import grouped_warehouse_record_fetcher
+from products.signals.backend.emission.registry import SignalEmitterOutput, SignalSourceTableConfig
+
+logger = get_logger(__name__)
+
+GOOGLE_PLAY_CONSOLE_ERROR_ISSUE_FIELDS = (
+    "issue_name",
+    "issue_type",
+    "cause",
+    "code_location",
+    "report_count",
+    "affected_users",
+    "first_version",
+    "last_version",
+    "last_report_time",
+    "issue_url",
+)
+
+_EXTRA_FIELDS = tuple(f for f in GOOGLE_PLAY_CONSOLE_ERROR_ISSUE_FIELDS if f not in ("issue_name", "cause"))
+
+_SELECT_SQL = """
+    name AS issue_name,
+    any(type) AS issue_type,
+    any(cause) AS cause,
+    any(location) AS code_location,
+    max(error_report_count) AS report_count,
+    max(distinct_users) AS affected_users,
+    any(first_app_version) AS first_version,
+    any(last_app_version) AS last_version,
+    max(last_error_report_time) AS last_report_time,
+    any(issue_uri) AS issue_url
+"""
+
+
+def issue_source_id(record: dict[str, Any]) -> str:
+    return clean_text(record.get("issue_name"))
+
+
+google_play_console_error_issue_record_fetcher = grouped_warehouse_record_fetcher(
+    select_sql=_SELECT_SQL,
+    group_by_sql="name",
+    order_by_sql="report_count DESC",
+    source_id_for=issue_source_id,
+)
+
+
+def google_play_console_error_issue_emitter(team_id: int, record: dict[str, Any]) -> SignalEmitterOutput | None:
+    source_id = issue_source_id(record)
+    cause = clean_text(record.get("cause"))
+    location = clean_text(record.get("code_location"))
+    if not source_id or not (cause or location):
+        logger.info(
+            "Ignoring google_play_console error issue without a cause or location",
+            team_id=team_id,
+            signals_type="data-import-signals",
+        )
+        return None
+    issue_type = clean_text(record.get("issue_type")) or "Error"
+    lines = [f"Google Play {issue_type}: {cause}" if cause else f"Google Play {issue_type}"]
+    if location:
+        lines.append(f"Location: {location}")
+    stats = ", ".join(
+        part
+        for part in (
+            f"Reports: {clean_text(record.get('report_count'))}" if clean_text(record.get("report_count")) else "",
+            f"Users: {clean_text(record.get('affected_users'))}" if clean_text(record.get("affected_users")) else "",
+        )
+        if part
+    )
+    if stats:
+        lines.append(stats)
+    return SignalEmitterOutput(
+        source_product="google_play_console",
+        source_type="issue",
+        source_id=source_id,
+        description="\n".join(lines),
+        weight=1.0,
+        extra=build_extra(record, _EXTRA_FIELDS, ()),
+    )
+
+
+GOOGLE_PLAY_CONSOLE_ERROR_ISSUES_CONFIG = SignalSourceTableConfig(
+    source_product="google_play_console",
+    source_type="issue",
+    emitter=google_play_console_error_issue_emitter,
+    record_fetcher=google_play_console_error_issue_record_fetcher,
+    record_processed_outputs=True,
+    partition_field="toString(last_error_report_time)",
+    partition_field_is_datetime_string=True,
+    fields=GOOGLE_PLAY_CONSOLE_ERROR_ISSUE_FIELDS,
+    max_records=200,
+    actionability_prompt=ERROR_ACTIONABILITY_PROMPT,
+    summarization_prompt=ERROR_SUMMARIZATION_PROMPT,
+    description_summarization_threshold_chars=2000,
+)
